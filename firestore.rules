rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /shipments/{shipmentId} {
      // 1. Company/Admin Access: Full read and write if signed in via Firebase Auth
      allow read, write: if request.auth != null;
      
      // 2. Driver Access: 
      // Allows drivers to login by querying their specific document ID
      allow get: if true;
      
      // Allows drivers to simulate disruptions by updating specific risk/ETA fields
      allow update: if true 
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['risk', 'eta', 'optimizedETA']);
    }
  }
}
